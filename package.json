{
  "name": "meridian-construction",
  "version": "1.0.0",
  "description": "Meridian Constructions corporate website and API server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/build-pages.js && node --watch server.js",
    "build": "node scripts/build-pages.js",
    "prestart": "node scripts/build-pages.js",
    "adopt-photos": "node scripts/adopt-photos.js",
    "check:images": "node scripts/check-images.js",
    "check:backend": "node scripts/check-backend.js",
    "check:vercel": "node scripts/check-vercel-upload.js",
    "test": "node test/api.test.js",
    "test:browser": "node test/browser.test.js && node test/fallback.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "construction",
    "engineering",
    "express",
    "website"
  ],
  "author": "Meridian Constructions",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.19.2"
  }
}
